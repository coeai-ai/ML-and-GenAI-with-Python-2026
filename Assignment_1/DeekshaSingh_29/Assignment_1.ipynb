#Find area of rectangle
Length = float(input("Enter the length of the rectangle: "))
Breadth = float(input("Enter the breadth of the rectangle: "))
Area = Length * Breadth
print("Area of the rectangle: ", Area)

#Find simple interest
Principle = float(input("Enter the principle: "))
Rate = float(input("Enter the rate: "))
Time = float(input("Enter the time: "))
SI = (Principle * Rate * Time) / 100
print("Simple Interest =", SI)

#Convert temperature from Celsius to Fahrenheit.
TC = float(input("Enter the temperature in celsius: "))
TF = ((9/5)*TC) + 32
print("Temperature in Fahrenheit will be", TF)

#Calculate average of 3 numbers.
no1 = float(input("Enter the 1st number: "))
no2 = float(input("Enter the 2nd number: "))
no3 = float(input("Enter the 3rd number: "))
Avg = (no1 * no2 * no3) / 3
print("Average of 3 numbers =", Avg)

#Swap two numbers without third variable
a = float(input("Enter the 1st number: "))
b = float(input("Enter the 2nd number: "))
print(f"Before swapping: {a}, {b}")
a, b = b, a
print(f"After swapping: {a}, {b}")


#Create a student report program that take student details using input(), store marks in variables, calculate total and percentage.
#Take student's name input
stud_name = (input("Enter the student's name: "))
#Take student's roll number input
stud_roll = float(input("Enter the student's roll no.: "))
#Take student's marks input
m1 = float(input("Enter the marks of 1st subject: "))
m2 = float(input("Enter the marks of 2nd subject: "))
m3 = float(input("Enter the marks of 3rd subject: "))
m4 = float(input("Enter the marks of 4th subject: "))
#Calculate the total
total = m1 + m2 + m3 + m4
#Calculate the percentage
perc = total / 4
print("----Student's Detail----")
print(f"Student's name: {stud_name}")
print(f"Student's roll no. : {stud_roll}")
print(f"Studentt's total marks: {total}")
print(f"Student's marks percentage: {perc}")